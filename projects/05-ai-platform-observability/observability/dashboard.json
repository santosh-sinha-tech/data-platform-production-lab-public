{
  "uid": "ai-lab",
  "title": "AI Platform live telemetry",
  "schemaVersion": 40,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Transport request rate",
      "type": "timeseries",
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(ai_requests_total[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Provider timeout rate",
      "type": "timeseries",
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(ai_provider_attempts_total{status=\"timeout\"}[1m])) / sum(rate(ai_provider_attempts_total[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Latency p95",
      "type": "timeseries",
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ai_stage_seconds_bucket{stage=\"end_to_end\"}[1m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Simulated cost",
      "type": "timeseries",
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(ai_simulated_cost_dollars_total)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Quality failures",
      "type": "timeseries",
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "ai_quality_failures_total",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Fallback requests",
      "type": "timeseries",
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "ai_fallbacks_total",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Retries",
      "type": "timeseries",
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "ai_retries_total",
          "refId": "A"
        }
      ]
    }
  ]
}