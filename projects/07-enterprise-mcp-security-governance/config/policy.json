{
  "protocol": "2025-11-25",
  "servers": {
    "operations": {
      "trust": "approved",
      "version": 1,
      "owner": "platform",
      "environment": "lab",
      "transport": "stdio",
      "tools": [
        "pipeline_status",
        "data_contract",
        "incident_runbook",
        "create_ticket",
        "rerun_pipeline",
        "change_config"
      ]
